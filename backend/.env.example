# ==============================================================================
# Expense Tracker Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to your local .env file:
#      cp .env.example .env          (or backend/.env)
# 2. Open your actual .env file manually and fill in your real credentials.
# 3. NEVER commit your actual .env file to Git. Only commit this .env.example file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Local PostgreSQL Docker Service Configuration
# ------------------------------------------------------------------------------
# Used by docker-compose.yml to spin up the local PostgreSQL container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=expense_tracker
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. Database Connection Strings (Storage Variables)
# ------------------------------------------------------------------------------
# [A] Local PostgreSQL:
# Used when running backend locally on your host or via local Docker.
LOCAL_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/expense_tracker

# [B] Supabase PostgreSQL:
# Obtain this from Supabase Dashboard -> Project Settings -> Database -> Connection string (URI tab).
# IMPORTANT:
# - Use Connection Pooler in "Session" mode (Port 5432), NOT Transaction mode (Port 6543) or Direct (requires IPv6).
# - Prefix with 'postgresql+psycopg://' so SQLAlchemy uses the psycopg3 driver.
# - URL-encode special characters in your password (e.g., '@' -> '%40', ':' -> '%3A').
SUPABASE_DATABASE_URL=postgresql+psycopg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres

# ------------------------------------------------------------------------------
# 3. Active Runtime Database Connection (Consumed by FastAPI & Alembic)
# ------------------------------------------------------------------------------
# The application code ONLY reads DATABASE_URL. To switch between environments,
# assign DATABASE_URL to your desired target:
#
# --> Option 1: Run against LOCAL PostgreSQL (Default for local development)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/expense_tracker
#
# --> Option 2: Run against SUPABASE PostgreSQL (Cloud Database)
# To activate Supabase, uncomment the line below and comment out Option 1 above:
# DATABASE_URL=postgresql+psycopg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres

# ------------------------------------------------------------------------------
# 4. Backend Service Configuration
# ------------------------------------------------------------------------------
# Port exposed on host when running via Docker Compose
BACKEND_PORT=8000

# ------------------------------------------------------------------------------
# 5. Authentication & JWT Security
# ------------------------------------------------------------------------------
# Cryptographically secure random secret key (e.g. generated via `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-secure-random-secret-key-at-least-32-chars
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# ------------------------------------------------------------------------------
# 6. CORS & Frontend Origin
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins
FRONTEND_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 7. Scheduled Jobs Security
# ------------------------------------------------------------------------------
# Secret token required in header 'X-Cron-Secret' for daily recurring maintenance
CRON_SECRET=change-me-to-a-secure-random-cron-secret-token

# ------------------------------------------------------------------------------
# 8. Rate Limiting (SlowAPI)
# ------------------------------------------------------------------------------
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=5/minute

# ------------------------------------------------------------------------------
# 9. Application Environment
# ------------------------------------------------------------------------------
# Options: development | staging | production
ENVIRONMENT=development
