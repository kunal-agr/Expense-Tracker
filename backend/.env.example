# Database (PostgreSQL)
# For local dev using psycopg3 driver or psycopg2:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/expense_tracker

# Authentication (JWT)
JWT_SECRET=change-me-to-a-secure-random-secret-key-at-least-32-chars
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# CORS / Frontend origin
FRONTEND_ORIGIN=http://localhost:5173

# Scheduler / Daily Cron Security
CRON_SECRET=change-me-to-a-secure-random-cron-secret-token

# Rate Limiting (slowapi)
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=5/minute

# Environment (development | production)
ENVIRONMENT=development
